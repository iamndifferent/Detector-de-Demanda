{
  "name": "Predictor de demanda",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install -r requirements-dev.txt",
  "postAttachCommand": "streamlit run streamlit_app.py --server.headless true --server.enableCORS false --server.enableXsrfProtection false",
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": { "label": "Predictor de demanda", "onAutoForward": "openPreview" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"]
    }
  }
}
